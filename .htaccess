# Silkwood Hotel — clean URL rewrites + cache headers (Apache / LiteSpeed)
# Staging is nginx; this file does NOT apply on staging.silkwoodhotels.com.
# Keep for Apache hosts or LiteSpeed that reads .htaccess.
# Upload to the site document root alongside index.html.
#
# Cache policy (when mod_headers is available):
#   HTML → no-cache (store + must revalidate)
#   CSS/JS → long-lived immutable (use tools/stamp-assets.ps1 for ?v= hashes)
#   images/fonts/video → long-lived

<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteBase /

  # 301: /index.html → /
  RewriteCond %{THE_REQUEST} \s/+index\.html[\s?] [NC]
  RewriteRule ^index\.html$ / [R=301,L]

  # 301: /page.html → /page
  RewriteCond %{THE_REQUEST} \s/+(.+?)\.html[\s?] [NC]
  RewriteRule ^ %1 [R=301,L]

  # Serve /page as page.html (do not touch real files/folders)
  RewriteCond %{REQUEST_FILENAME} !-f
  RewriteCond %{REQUEST_FILENAME} !-d
  RewriteCond %{REQUEST_FILENAME}.html -f
  RewriteRule ^(.+?)/?$ $1.html [L]
</IfModule>

DirectoryIndex index.html

<IfModule mod_headers.c>
  # HTML — must revalidate so stamped CSS/JS URLs stay fresh
  <FilesMatch "\.(html?)$">
    Header set Cache-Control "no-cache"
  </FilesMatch>

  # Fingerprinted CSS/JS — long cache
  <FilesMatch "\.(css|js)$">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </FilesMatch>

  # Media — long cache
  <FilesMatch "\.(png|jpe?g|gif|webp|ico|svg|woff2?|mp4)$">
    Header set Cache-Control "public, max-age=31536000"
  </FilesMatch>
</IfModule>
